<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.ativ.greenrx</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="ATIV" string="ATIV" name="ativ_greenrx">
                    <block title="ATIV" name="ativ_greenrx_setting_container">
                        <setting id="ativ_erechnung_setting" string="E-Rechnung (ZUGFeRD)" help="Attach a ZUGFeRD factur-x.xml e-invoice to the generated purchase documents.">
                            <field name="ativ_erechnung_enabled"/>
                            <div class="content-group" invisible="not ativ_erechnung_enabled">
                                <div class="mt16">
                                    <label for="ativ_erechnung_issuer_partner_id" class="o_light_label mr8"/>
                                    <field name="ativ_erechnung_issuer_partner_id" class="oe_inline"/>
                                </div>
                            </div>
                        </setting>
                        <setting id="ativ_purchase_no_autosave_setting" string="Purchase orders: explicit save only" help="Disable autosave on the purchase order form; users must click Save.">
                            <field name="ativ_purchase_no_autosave"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
